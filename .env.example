# Copy file này thành `.env` (cùng thư mục — root repo, nơi có
# docker-compose.yml), KHÔNG commit `.env`. Docker Compose tự nạp file
# `.env` ở cùng thư mục để thay thế các biến ${VAR} trong docker-compose.yml
# — chỉ cần khi chạy `docker compose up` (không cần nếu chạy backend qua
# `mvn spring-boot:run`, khi đó dùng pps-education-backend/.env riêng).

# --- Cloudflare R2 (Object Storage tương thích S3 API) — file audio/ảnh cho
# Question.audioUrl/imageUrl (UC-40). Tạo bucket + API Token (Object Read &
# Write, scope theo đúng bucket) tại dash.cloudflare.com > R2 Object Storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# URL công khai của bucket: bật "r2.dev" (dev/test, có rate-limit) hoặc gắn
# Custom Domain (khuyến nghị production) trong Settings > Public access của bucket.
R2_PUBLIC_BASE_URL=
# Server production tự host (2026-08-26): set = URL nội bộ MinIO (VD
# http://minio:9000) để dùng MinIO tự host thay Cloudflare R2 thật — xem
# pps-education-backend/.env.example (mục Cloudflare R2) để biết chi tiết.
R2_ENDPOINT_URL=

# --- SMTP gửi mail (UC-15 HS vắng không phép, cảnh báo thiếu BTVN theo lộ
# trình...) — để trống thì delivery chuyển FAILED + retry, không crash app.
# Xem hướng dẫn tạo Gmail App Password ở pps-education-backend/.env.example
# (mục SMTP) — copy đúng 4 giá trị đó sang đây khi chạy qua Docker Compose.
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=

# Thông tin liên hệ hiển thị ở footer chuẩn của mọi email — để trống thì footer
# giữ nguyên placeholder "[Hotline PPS]"/"[Email hỗ trợ]"/"[Website PPS]".
MAIL_CONTACT_HOTLINE=
MAIL_CONTACT_SUPPORT_EMAIL=
MAIL_CONTACT_WEBSITE=

# --- SPIKE/TEST riêng "AI chấm Speaking" (2026-08-22, xem SpeakingAiGradingTestService,
# trang FE /dev-tools/speaking-grading-test) — KHÔNG phải cấu hình của 1 UC chính thức, chỉ
# phục vụ đánh giá khả thi kỹ thuật/chi phí. Để trống thì endpoint trả lỗi có kiểm soát.
# OPENAI_API_KEY: tạo tại platform.openai.com/api-keys — dùng cho Speech-to-Text (gpt-4o-mini-transcribe).
# ANTHROPIC_API_KEY: tạo tại console.anthropic.com/settings/keys — dùng để chấm nội dung/ngữ pháp (Claude Haiku 4.5).
#   Anthropic yêu cầu nạp tiền trước khi gọi được API.
# GEMINI_API_KEY: tạo tại aistudio.google.com/apikey — dùng thay Claude để chấm bài khi chưa muốn nạp
#   tiền Anthropic (Gemini free tier, KHÔNG cần thẻ thanh toán — chỉ dùng cho test kỹ thuật, KHÔNG
#   dùng free tier cho dữ liệu học sinh thật vì Google có thể dùng dữ liệu free tier để cải thiện
#   sản phẩm). Chỉ cần 1 trong 2 (ANTHROPIC_API_KEY hoặc GEMINI_API_KEY), ưu tiên Claude nếu có cả 2.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- SPIKE (nhánh spike/openrouter-ai-rotation) - 9Router (https://github.com/decolua/9router), proxy
# xoay vòng nhiều provider/API key, chạy TRÊN MÁY HOST (npm install -g 9router && 9router, cổng mặc
# định 20128) - qua Docker Compose PHẢI dùng host.docker.internal (KHÔNG phải localhost — localhost
# trong container là chính nó, không phải máy host). Lấy API key ở Dashboard 9Router → Endpoint & Key.
# NINE_ROUTER_MODEL = combo đã tạo trong Dashboard → Combo & Vision Adapter (chấm text).
# NINE_ROUTER_AUDIO_MODEL = model đa phương thức trong Dashboard → Combo & Vision Adapter (chấm audio
# trực tiếp — PHẢI là Gemini/GPT-4o-audio, KHÔNG dùng combo có Claude vì Claude không nhận input audio).
# NINE_ROUTER_STT_MODEL = model trong Dashboard → Media Providers → Speech To Text.
NINE_ROUTER_BASE_URL=http://host.docker.internal:20128/v1
NINE_ROUTER_API_KEY=
NINE_ROUTER_MODEL=
NINE_ROUTER_STT_MODEL=groq/whisper-large-v3-turbo
NINE_ROUTER_AUDIO_MODEL=ag/gemini-3.5-flash-low
