# Mẫu biến môi trường cho dev cục bộ — copy thành `.env`, KHÔNG commit `.env`.
#
# Lưu ý: Spring Boot không tự đọc file `.env` (đây không phải Node.js). File
# này chỉ là tài liệu tham khảo + nguồn cho docker-compose (Docker Compose tự
# đọc `.env` ở root nếu bạn đổi docker-compose.yml sang dùng ${VAR}). Để dùng
# khi chạy `mvn spring-boot:run` trực tiếp (không qua Docker), có 2 cách:
#   1. Set từng biến trong shell trước khi chạy (PowerShell):
#        $env:DB_PASSWORD = "root123456"; mvn spring-boot:run
#   2. Hoặc bỏ qua hoàn toàn — application.yml đã có default khớp sẵn với
#      docker-compose.yml (postgres user/password/db), chỉ cần
#      `docker compose up -d postgres` rồi `mvn spring-boot:run` là chạy được,
#      KHÔNG cần set biến nào cả trừ khi bạn muốn override.
#
# Giá trị dưới đây khớp docker-compose.yml — đổi nếu bạn tự sửa docker-compose.

# --- Database (khớp service `postgres` trong docker-compose.yml) ---
DB_URL=jdbc:postgresql://localhost:5432/pps_education
DB_USERNAME=pps_app
DB_PASSWORD=root123456

# --- JWT (FR-AUT-01) — đổi sang secret thật khi lên staging/prod ---
JWT_SECRET=CHANGE_THIS_SECRET_IN_ENV_MIN_256_BITS_xxxxxxxxxxxxxxxxxxxx

# --- Google OAuth id_token verification (UC-01 Main Flow bước 4/A4) ---
# CSV client-id (Web/Mobile) dùng làm audience khi verify id_token. Để trống
# nếu chưa cần test đăng nhập Google — các luồng khác không bị ảnh hưởng.
GOOGLE_OAUTH_CLIENT_IDS=

# --- Khác ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Nếu máy bạn đã có PostgreSQL native chiếm sẵn port 5432 (xung đột với
# Postgres trong docker-compose), xem docker-compose.override.yml.example
# hoặc đổi port publish của service `postgres` sang port khác, rồi cập nhật
# DB_URL ở trên cho khớp.
