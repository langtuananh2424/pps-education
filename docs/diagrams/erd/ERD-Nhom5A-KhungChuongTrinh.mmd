    curriculums {
        BIGSERIAL id PK
        UUID uuid UK
        VARCHAR code UK
        VARCHAR name
        BIGINT site_id FK
        BIGINT parent_curriculum_id FK
        VARCHAR class_category
        VARCHAR level
        INT total_periods
        DECIMAL default_grade_pass_threshold
        VARCHAR status
        BIGINT created_by FK
        BIGINT approved_by FK
        TIMESTAMPTZ approved_at
        TIMESTAMPTZ deleted_at
    }

    curriculum_subjects {
        BIGSERIAL id PK
        BIGINT curriculum_id FK
        VARCHAR subject_code
        BIGINT skill_id FK
        VARCHAR name
        INT period_count
        INT display_order
    }

    skills {
        BIGSERIAL id PK
        VARCHAR code UK
        VARCHAR name
        TEXT description
        BOOLEAN is_active
    }

    classes {
        BIGSERIAL id PK
        UUID uuid UK
        VARCHAR class_code UK
        VARCHAR name
        BIGINT site_id FK
        BIGINT curriculum_id FK
        VARCHAR class_type
        VARCHAR class_category
        INT max_students
        INT min_students
        DATE start_date
        DATE end_date
        VARCHAR academic_year
        VARCHAR status
        BIGINT created_by FK
        TIMESTAMPTZ deleted_at
    }

    class_teachers {
        BIGSERIAL id PK
        BIGINT class_id FK
        BIGINT teacher_user_id FK
        VARCHAR teacher_role
        BIGINT subject_id FK
        DATE assigned_from
        DATE assigned_to
        BIGINT assigned_by FK
    }

    class_enrollments {
        BIGSERIAL id PK
        BIGINT class_id FK
        BIGINT student_id FK
        DATE enrolled_date
        DATE withdrawn_date
        VARCHAR status
        BIGINT enrolled_by FK
        BIGINT import_job_id FK
