# Copy file này thành `.env` (cùng thư mục — pps-education-backend/, nơi
# chạy `mvn spring-boot:run`), KHÔNG commit `.env`.
#
# Nhờ dependency me.paulschwarz:spring-dotenv (pom.xml), Spring Boot TỰ ĐỘNG
# nạp file `.env` này mỗi khi khởi động (mvn spring-boot:run, java -jar, IDE
# Run) — không cần export biến môi trường thủ công nữa.
#
# Không set gì cả cũng chạy được: application.yml đã có default khớp sẵn với
# docker-compose.yml. Chỉ cần tạo `.env` khi muốn OVERRIDE (VD máy đã có
# PostgreSQL native chiếm port 5432 — đổi DB_URL sang port khác, xem
# docker-compose.override.yml.example ở root repo).

# --- Database (khớp service `postgres` trong docker-compose.yml) ---
DB_URL=jdbc:postgresql://localhost:5432/pps_education
DB_USERNAME=pps_app
DB_PASSWORD=dev_only_not_a_real_secret

# --- JWT (FR-AUT-01) — đổi sang secret thật khi lên staging/prod ---
JWT_SECRET=CHANGE_THIS_SECRET_IN_ENV_MIN_256_BITS_xxxxxxxxxxxxxxxxxxxx

# --- Google OAuth id_token verification (UC-01 Main Flow bước 4/A4) ---
# CSV client-id (Web/Mobile) dùng làm audience khi verify id_token. Để trống
# nếu chưa cần test đăng nhập Google — các luồng khác không bị ảnh hưởng.
GOOGLE_OAUTH_CLIENT_IDS=

# --- Webhook ngân hàng (UC-30 Main Flow bước 5-6) — đổi sang secret thật khi tích hợp ngân hàng thật ---
BANK_WEBHOOK_SECRET=CHANGE_THIS_SECRET_IN_ENV

# --- Cloudflare R2 (Object Storage tương thích S3 API) — file audio/ảnh cho
# Question.audioUrl/imageUrl (UC-40). Tạo bucket + API Token (Object Read &
# Write, scope theo đúng bucket) tại dash.cloudflare.com > R2 Object Storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# URL công khai của bucket: bật "r2.dev" (dev/test, có rate-limit) hoặc gắn
# Custom Domain (khuyến nghị production) trong Settings > Public access của bucket.
R2_PUBLIC_BASE_URL=

# --- Khác ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# --- Tài khoản demo (DevUserSeeder) — tạo sẵn 11 tài khoản (1/role, mật khẩu
# Dev@123456) lúc khởi động app, CHỈ dùng local dev. Đặt false hoặc xoá dòng
# này nếu không muốn seed. ---
SEED_DEV_USERS=true
