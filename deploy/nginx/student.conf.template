# Template server block cho app học sinh (thư mục source vẫn tên
# pps-education-frontend/user - CHƯA đổi tên thư mục/CI, chỉ đổi domain/tên
# file nginx cho phù hợp môi trường học đường, xác nhận với người dùng
# 2026-09-15) — copy thành 2 file thật trên server:
#   /etc/nginx/sites-available/student-staging.<DOMAIN>.conf
#   /etc/nginx/sites-available/student.<DOMAIN>.conf
# rồi thay __HOSTNAME__/__ROOT_PATH__/__API_PORT__ theo đúng stack (xem
# deploy/README.md bảng giá trị). Chỉ listen 80 — TLS do Cloudflare Tunnel lo.

server {
    listen 80;
    server_name __HOSTNAME__;

    root __ROOT_PATH__;
    index index.html;

    # Rà soát bảo mật 2026-09-28 - cần pps-security.conf (conf.d) và
    # pps-security-headers.conf (snippets), xem file pps-security.conf.
    include snippets/pps-security-headers.conf;
    limit_req_status 429;

    # Đăng nhập (mật khẩu + Google): chặn dò mật khẩu hàng loạt theo IP. Chỉ áp cho
    # /api/auth/login* - /api/auth/me, /refresh gọi thường xuyên nên để zone API chung.
    location ^~ /api/auth/login {
        limit_req zone=pps_auth burst=60 nodelay;
        proxy_pass http://127.0.0.1:__API_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $pps_client_ip;
        proxy_set_header X-Forwarded-For $pps_client_ip;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Upload media dùng chung (video ≤200MB): chặn làm đầy ổ đĩa MinIO.
    location = /api/media/upload {
        limit_req zone=pps_upload burst=20 nodelay;
        client_max_body_size 210m;
        proxy_pass http://127.0.0.1:__API_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $pps_client_ip;
        proxy_set_header X-Forwarded-For $pps_client_ip;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        # Upload qua API khác (VD mẫu báo cáo, import Excel): request ≤205MB (khớp
        # spring.servlet.multipart.max-request-size). Mặc định nginx là 1MB -> file
        # >1MB bị chặn bằng 413 trước khi tới backend.
        client_max_body_size 210m;
        limit_req zone=pps_api burst=500 nodelay;
        proxy_pass http://127.0.0.1:__API_PORT__/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # IP thật (CF-Connecting-IP) thay vì 127.0.0.1 của cloudflared - backend dùng cho
        # login_attempts/audit log và LoginIpThrottle (server.forward-headers-strategy=native).
        proxy_set_header X-Real-IP $pps_client_ip;
        proxy_set_header X-Forwarded-For $pps_client_ip;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Asset Vite build ra có hash trong tên file (/assets/index-a1b2c3.js) — nội dung
    # không bao giờ đổi dưới cùng 1 tên, cache 1 năm an toàn. Đổi code -> index.html
    # trỏ sang tên file mới.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        include snippets/pps-security-headers.conf;
        try_files $uri =404;
    }

    # App này dùng vite-plugin-pwa (registerType autoUpdate): service worker chỉ phát
    # hiện bản build mới khi tải được sw.js/manifest/index.html MỚI từ server -> các
    # file không có hash này bắt buộc no-cache (cùng lý do sự cố shortcut iOS
    # 2026-09-21 ở app admin: client giữ bundle cũ, không tự cập nhật sau deploy).
    location ~ ^/(index\.html|sw\.js|registerSW\.js|manifest\.webmanifest)$ {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        include snippets/pps-security-headers.conf;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html; # SPA fallback
    }
}
