# Copy file này thành `.env` (cùng thư mục — pps-education-frontend/user/),
# KHÔNG commit `.env`.

# Google Sign-In (UC-01 Main Flow bước 4) — dùng CHUNG OAuth Client ID với
# app admin/, nhưng phải thêm riêng http://localhost:3001 (origin của app
# này) vào "Authorized JavaScript origins" ở Google Cloud Console > APIs &
# Services > Credentials, nếu không nút Google sẽ báo lỗi origin không khớp
# dù client ID đúng. PHẢI khớp đúng 1 giá trị trong GOOGLE_OAUTH_CLIENT_IDS
# ở pps-education-backend/.env thì backend mới verify được id_token.
VITE_GOOGLE_CLIENT_ID=

# Kenh PUSH (FCM Web) - xem src/lib/pushNotifications.ts +
# PushNotificationSender.java (backend). Lay o Firebase Console > Project
# Settings > General > "Your apps" > Web app (SDK config); VAPID key o
# Project Settings > Cloud Messaging > Web Push certificates. Cac gia tri
# nay KHONG phai secret (thiet ke de lo ra client) - an toan khi bundle vao
# JS cong khai. De trong thi app van chay binh thuong, chi tat rieng kenh
# PUSH (setupPushNotifications() tra ve "not-configured", khong throw).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
